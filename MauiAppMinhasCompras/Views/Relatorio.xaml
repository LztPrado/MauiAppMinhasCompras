<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.Relatorio"
             Title="Relatório por Categoria">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Relatório por Categoria"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label x:Name="lbl_alimentos"
                   Text="Alimentos: R$ 0,00"
                   FontSize="18" />

            <Label x:Name="lbl_higiene"
                   Text="Higiene: R$ 0,00"
                   FontSize="18" />

            <Label x:Name="lbl_limpeza"
                   Text="Limpeza: R$ 0,00"
                   FontSize="18" />

            <Label x:Name="lbl_outros"
                   Text="Outros: R$ 0,00"
                   FontSize="18" />

            <BoxView HeightRequest="1" />

            <Label x:Name="lbl_total"
                   Text="Total geral: R$ 0,00"
                   FontSize="20"
                   FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>