<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout>
        <SearchBar x:Name="txt_search" 
                   Placeholder="Busca de Produtos" 
                   TextChanged="txt_search_TextChanged"/>

        <CollectionView x:Name="lst_produtos"
                        SelectionMode="Single"
                        SelectionChanged="lst_produtos_SelectionChanged">

            <CollectionView.Header>
                <Grid ColumnDefinitions="*, *, *, *, *">
                    <Label Text="Id" Grid.Column="0" />
                    <Label Text="Descrição" Grid.Column="1" />
                    <Label Text="Preço" Grid.Column="2" />
                    <Label Text="Qnt" Grid.Column="3" />
                    <Label Text="Total" Grid.Column="4" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Remover"
                                           BackgroundColor="Red"
                                           Invoked="MenuItem_Clicked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Grid ColumnDefinitions="*, *, *, *, *">
                            <Label Text="{Binding Id}" Grid.Column="0" />
                            <Label Text="{Binding Descricao}" Grid.Column="1" />
                            <Label Text="{Binding Preco}" Grid.Column="2" />
                            <Label Text="{Binding Quantidade}" Grid.Column="3" />
                            <Label Text="{Binding Total}" Grid.Column="4" />
                        </Grid>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>